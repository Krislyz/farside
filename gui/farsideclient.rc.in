1 VERSIONINFO
 FILEVERSION @FARSIDE_VERSION_COMMA@,0
 PRODUCTVERSION @FARSIDE_VERSION_COMMA@,0
 FILEFLAGSMASK 0x17L
 FILEFLAGS 0x0L
 FILEOS 0x4L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080904b0"
        BEGIN
            VALUE "CompanyName", "Moonthia"
            VALUE "FileDescription", "Farside Client"
            VALUE "FileVersion", "@FARSIDE_VERSION@.0\0"
            VALUE "InternalName", "FarsideClient"
            VALUE "LegalCopyright", "AGPLv3. Farside: Moonthia 2026"
            VALUE "OriginalFilename", "FarsideClient.exe"
            VALUE "ProductName", "Farside Client"
            VALUE "ProductVersion", "@FARSIDE_VERSION@.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x809, 1200
    END
END
IDI_ICON1 ICON DISCARDABLE "farside.ico"
